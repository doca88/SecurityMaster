{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: SecurityMasterService",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/SecurityMasterService/bin/Debug/net10.0/SecurityMasterService.dll",
            "args": [],
            "cwd": "${workspaceFolder}/SecurityMasterService",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(http?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}